# Local development and the tests. Copy this file to app/.env.local, which git ignores, and fill
# in the passwords from the repository root's .env. Everything here points at synapse_test, the
# test database, on the stack's Postgres (localhost:5434). The integration and end-to-end suites
# and `npm run db:migrate:test` refuse to run unless DATABASE_URL and PGDATABASE both name it.
#
# Start Postgres and migrate it with `docker compose up -d --build postgres migrate` from the
# repository root. After a change to app/drizzle/, `npm run db:migrate:test` migrates
# synapse_test.

# The superuser, for migrate.sh and for tests that read the catalog: POSTGRES_USER and
# POSTGRES_PASSWORD from .env.
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
PGPASSWORD=replace-with-POSTGRES_PASSWORD
PGDATABASE=synapse_test

# The same value as in .env. migrate.sh sets synapse_app's password on every run, and the role is
# shared by every database in the cluster, so a different value here would lock the stack's app
# out. db:migrate:test and the migrate test stop if it doesn't match.
SYNAPSE_APP_DB_PASSWORD=replace-with-SYNAPSE_APP_DB_PASSWORD

# The app's role, for `npm run dev` and the tests that act as the app.
DATABASE_URL=postgresql://synapse_app:replace-with-SYNAPSE_APP_DB_PASSWORD@localhost:5434/synapse_test

# The end-to-end suite's port. Optional; it defaults to 3102.
#E2E_PORT=3102
