# Synapse's stack (docker-compose.yml). Copy this file to .env, which git ignores, and replace
# each placeholder before the first `docker compose up --build`.
#
# Generate each password with:  openssl rand -hex 24
# They go into connection URLs unescaped, so migrate stops on any character outside
# A-Z a-z 0-9 . _ ~ -

# The Postgres superuser, used only by the migrate job. It's applied only when the data volume is
# first initialized: changing it here later locks migrate out. Change the role's password in
# Postgres first, then here.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
# The maintenance database initdb creates. migrate creates synapse and synapse_test.
POSTGRES_DB=postgres

# The app's role, synapse_app. migrate sets its password from here on every run, so a new value
# takes effect on the next `up`. app/.env.local needs the same value.
SYNAPSE_APP_DB_PASSWORD=replace-with-openssl-rand-hex-24
